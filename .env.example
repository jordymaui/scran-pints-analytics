# Set these as Vercel server environment variables; never commit real values.
# Optional local development may use ignored .env.local.
# Use the existing Supabase project and enable its Google Auth provider.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only Data API access after applying the reviewed Supabase provisioning.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Comma-separated exact Google account addresses. Empty means access is denied.
WORKSHOP_ALLOWED_EMAILS=
# Exact deployed origin, no path. Use a dedicated value for each deployment.
APP_ORIGIN=https://scran-pints-analytics.vercel.app
# In Supabase Auth URL configuration, allow APP_ORIGIN/api/auth/callback**
# (the suffix permits our random flow_state query). Preserve the existing main
# site's Supabase Site URL and redirect allowlist; add this analytics callback.
# Google OAuth callback is the URL shown by Supabase, normally:
# https://YOUR_PROJECT.supabase.co/auth/v1/callback
# Production cookies are always Secure. For local development only:
# APP_ORIGIN=http://localhost:5186
# Loopback HTTP uses separate dev-prefixed HttpOnly cookies and still requires
# real Google authorization. Configure that specific callback in Supabase too.
# Dedicated Google reporting OAuth client, authorized redirect URI:
# APP_ORIGIN/api/connections/youtube?action=callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Server-only API key restricted to YouTube Data API v3; independent public counters.
YOUTUBE_PUBLIC_API_KEY=
# Instagram Login: a Business/Creator account and Instagram app with read-only
# instagram_business_basic + instagram_business_manage_insights permissions.
# Exact web callback: APP_ORIGIN/api/connections/instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Set to the Graph API version selected in the Meta app.
INSTAGRAM_API_VERSION=v24.0
# TikTok Login Kit + Display API, including approved read-only reporting scopes.
# Exact web callback: APP_ORIGIN/api/connections/tiktok (no query string).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Vercel sends this bearer secret when invoking the scheduled /api/sync job.
# Generate a long random value; keep it only in Vercel server configuration.
CRON_SECRET=
